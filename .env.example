# Spec Studio — chép thành .env.local (setup.sh tự làm). Không commit .env.local.

# ---- Port (tránh trùng với dự án khác đang chạy) ----
PORT=3020
PORT_START=3021

# ---- Data layer ----
# JSON     : mỗi model một file trong DATA_DIR (mặc định, không cần cài gì)
# POSTGRES : dùng DATABASE_URL; dev chạy `make db-up` để bật Postgres bằng docker compose
DATA_DRIVER=JSON
DATA_DIR=~/.spec-studio/data
DATABASE_URL=postgres://spec_studio:spec_studio@localhost:5432/spec_studio

# ---- Google (Drive storage + NotebookLM Drive Sync) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
