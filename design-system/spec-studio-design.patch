+.ss-select__trigger { display: flex; align-items: center; gap: var(--space-2); width: 100%; height: var(--size-control); padding: 0 var(--space-2) 0 var(--space-3); border: 1px solid var(--color-input); border-radius: var(--radius-md); background: var(--color-card); color: var(--color-foreground); font: inherit; font-size: 13px; line-height: 18px; text-align: left; cursor: pointer; }
