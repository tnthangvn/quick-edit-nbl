+.ss-iconbtn:hover [data-icon="settings"] { transform: rotate(60deg); }
+.ss-iconbtn:hover [data-icon="plus"], .ss-iconbtn:hover [data-icon="x"] { transform: rotate(90deg); }
+.ss-iconbtn--sm { width: var(--size-control-sm); height: var(--size-control-sm); }
+.ss-iconbtn:hover { background: var(--color-accent); color: var(--color-foreground); }
+.ss-iconbtn.is-active { background: var(--color-primary-soft); color: var(--color-primary); }
+
+/* Kbd */
+.ss-kbd { display: inline-block; min-width: 18px; padding: 0 var(--space-1); border: 1px solid var(--color-border); border-bottom-width: 2px; border-radius: var(--radius-sm); background: var(--color-card); font-family: var(--font-mono); font-size: 11px; line-height: 16px; font-weight: 500; color: var(--color-muted-foreground); text-align: center; }
+
+/* StatusBadge */
+.ss-status { display: inline-flex; align-items: center; gap: var(--space-1); height: 20px; padding: 0 var(--space-1\.5); border-radius: var(--radius-sm); font-size: 12px; line-height: 16px; font-weight: 500; white-space: nowrap; }
