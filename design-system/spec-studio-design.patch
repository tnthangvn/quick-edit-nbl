+@import url("https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap");
+
+/* Spec Studio — component styles. Every value comes from tokens.css (--color-*, --space-*, --radius-*, --size-*, --shadow-*). */
+/* Motion — durations and easings (also in globals.css). Short, ease-out, no bounce. */
+:root { --duration-fast: 100ms; --duration-base: 150ms; --duration-slow: 220ms; --ease-out: cubic-bezier(0.2, 0, 0, 1); --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1); }
+@keyframes ss-pop-in { from { opacity: 0; transform: translateY(-4px) scale(.98); } to { opacity: 1; transform: none; } }
+@keyframes ss-pop-up { from { opacity: 0; transform: translateY(4px) scale(.98); } to { opacity: 1; transform: none; } }
+@keyframes ss-slide-in { from { opacity: 0; transform: translateX(16px); } to { opacity: 1; transform: none; } }
+@keyframes ss-scale-in { from { opacity: 0; transform: scale(.6); } to { opacity: 1; transform: none; } }
+.ss-pop { animation: ss-scale-in var(--duration-slow) var(--ease-out); }
+
+body { margin: 0; font-family: var(--font-sans); font-size: 14px; line-height: 20px; background: var(--color-background); color: var(--color-foreground); -webkit-font-smoothing: antialiased; }
+.ss-pad { padding: var(--space-4); }
+.ss-row { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
+.ss-stack { display: flex; flex-direction: column; gap: var(--space-3); }
+.ss-overline { font-size: 11px; line-height: 16px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--color-muted-foreground); }
+.ss-icon { flex: none; display: inline-block; width: var(--size-icon); height: var(--size-icon); }
+svg.ss-icon { width: auto; height: auto; }
+.ss-spin { animation: ss-spin 1s linear infinite; }
+@keyframes ss-spin { to { transform: rotate(360deg); } }
+@media (prefers-reduced-motion: reduce) {
+  [class*="ss-"], [class*="ss-"] * { transition-duration: 1ms !important; animation-duration: 1ms !important; }
+  .ss-spin { animation: ss-spin 1.6s linear infinite !important; }
+  .ss-btn:active:not(:disabled), .ss-iconbtn:active { transform: none !important; }
+}
+:where(.ss-btn, .ss-iconbtn, .ss-seg__opt, .ss-tab, .ss-menu__item, .ss-switch, .ss-spec, .ss-select__trigger, .ss-input):focus-visible { outline: 2px solid var(--color-ring); outline-offset: 1px; }
+
+/* Button */
+.ss-btn { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-1\.5); height: var(--size-control); padding: 0 var(--space-3); border: 1px solid transparent; border-radius: var(--radius-md); font: inherit; font-size: 13px; line-height: 18px; font-weight: 500; white-space: nowrap; cursor: pointer; transition: background-color var(--duration-base) var(--ease-out), border-color var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out), transform var(--duration-fast) var(--ease-out); }
+.ss-btn:active:not(:disabled) { transform: scale(.97); }
+.ss-btn .ss-icon { transition: transform var(--duration-slow) var(--ease-out); }
+.ss-btn--sm { height: var(--size-control-sm); padding: 0 var(--space-2); }
+.ss-btn--primary { background: var(--color-primary); color: var(--color-primary-foreground); }
+.ss-btn--primary:hover:not(:disabled) { background: color-mix(in srgb, var(--color-primary) 88%, var(--color-foreground)); }
+.ss-btn--secondary { background: var(--color-secondary); color: var(--color-secondary-foreground); }
+.ss-btn--secondary:hover:not(:disabled) { background: var(--color-accent); border-color: var(--color-border); }
+.ss-btn--outline { background: var(--color-card); color: var(--color-foreground); border-color: var(--color-input); }
+.ss-btn--outline:hover:not(:disabled) { background: var(--color-accent); }
+.ss-btn--ghost { background: transparent; color: var(--color-foreground); }
+.ss-btn--ghost:hover:not(:disabled) { background: var(--color-accent); }
+.ss-btn--tonal { background: var(--color-primary-soft); color: var(--color-primary); }
+.ss-btn--tonal:hover:not(:disabled) { border-color: var(--color-primary); }
+.ss-btn--destructive { background: var(--color-destructive); color: var(--color-destructive-foreground); }
+.ss-btn--destructive:hover:not(:disabled) { background: color-mix(in srgb, var(--color-destructive) 88%, var(--color-foreground)); }
+/* icon micro-motion: the icon acts out the verb on hover */
+.ss-btn:hover:not(:disabled) [data-icon="send-horizontal"] { transform: translateX(2px); }
+.ss-btn:hover:not(:disabled) [data-icon="refresh-cw"] { transform: rotate(180deg); }
+.ss-btn:hover:not(:disabled) [data-icon="cloud-upload"] { transform: translateY(-2px); }
+.ss-btn:hover:not(:disabled) [data-icon="x"] { transform: rotate(90deg); }
+.ss-btn:hover:not(:disabled) [data-icon="check"] { transform: scale(1.15); }
+.ss-btn:hover:not(:disabled) [data-icon="trash-2"] { transform: rotate(-8deg); }
+.ss-btn.is-loading { cursor: progress; }
+.ss-btn.is-loading:disabled { opacity: .8; }
+.ss-btn.is-success { transition-duration: 1ms; }
+.ss-btn:disabled { opacity: .45; cursor: not-allowed; }
+
+/* IconButton */
+.ss-iconbtn { display: inline-grid; place-items: center; width: var(--size-control); height: var(--size-control); padding: 0; border: 0; border-radius: var(--radius-md); background: transparent; color: var(--color-muted-foreground); cursor: pointer; transition: background-color var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out), transform var(--duration-fast) var(--ease-out); }
+.ss-iconbtn:active { transform: scale(.92); }
