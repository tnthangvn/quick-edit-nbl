+.ss-header__name { font-size: 14px; line-height: 20px; font-weight: 600; }
+.ss-header__path { margin-left: var(--space-2); font-family: var(--font-mono); font-size: 12px; line-height: 18px; color: var(--color-muted-foreground); }
+
