+.ss-menu__kbd { font-family: var(--font-mono); font-size: 11px; color: var(--color-muted-foreground); }
+.ss-menu__sep { height: 1px; margin: var(--space-1) calc(-1 * var(--space-1)); background: var(--color-border); }
+
+/* SpecSidebar */
+.ss-sidebar { display: flex; flex-direction: column; width: var(--size-sidebar); height: 100%; box-sizing: border-box; background: var(--color-sidebar); border-right: 1px solid var(--color-border); }
