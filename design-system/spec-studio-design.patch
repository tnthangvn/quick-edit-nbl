+.ss-status--unsaved { background: var(--color-primary-soft); color: var(--color-primary); }
+.ss-status--syncing { background: var(--color-primary-soft); color: var(--color-primary); }
+.ss-status--error { background: var(--color-destructive-soft); color: var(--color-destructive); }
+.ss-status--compact { width: 20px; padding: 0; justify-content: center; background: transparent; }
+.ss-dot { width: 8px; height: 8px; border-radius: var(--radius-full); background: currentColor; flex: none; }
+.ss-dot--primary { background: var(--color-primary); }
+
+/* Checkbox */
+.ss-check { position: relative; display: inline-flex; align-items: center; gap: var(--space-2); flex: none; cursor: pointer; -webkit-tap-highlight-color: transparent; }
+.ss-check input { position: absolute; left: 0; top: 50%; width: 16px; height: 16px; margin: -8px 0 0; opacity: 0; cursor: inherit; }
+.ss-check__box { position: relative; display: grid; place-items: center; width: 16px; height: 16px; flex: none; box-sizing: border-box; border: 1.5px solid var(--color-input); border-radius: var(--radius-sm); background: var(--color-card); color: var(--color-primary-foreground); transition: background-color var(--duration-base) var(--ease-out), border-color var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out), transform var(--duration-fast) var(--ease-out); }
+.ss-check__box svg { position: absolute; inset: -1.5px; }
+.ss-check__mark { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset var(--duration-slow) var(--ease-out); }
+.ss-check:hover .ss-check__box { border-color: var(--color-primary); box-shadow: 0 0 0 3px var(--color-primary-soft); }
+.ss-check:active .ss-check__box { transform: scale(.9); }
+.ss-check[data-state="checked"] .ss-check__box, .ss-check[data-state="mixed"] .ss-check__box { background: var(--color-primary); border-color: var(--color-primary); }
+.ss-check[data-state="checked"] .ss-check__mark, .ss-check[data-state="mixed"] .ss-check__mark { stroke-dashoffset: 0; transition-delay: 40ms; }
+.ss-check input:focus-visible + .ss-check__box { outline: 2px solid var(--color-ring); outline-offset: 2px; }
+.ss-check.is-disabled { cursor: not-allowed; opacity: .45; }
+.ss-check.is-disabled .ss-check__box { box-shadow: none; }
+.ss-check__label { font-size: 13px; line-height: 18px; color: var(--color-foreground); }
+/* in the spec list: quiet until the row is hovered, focused or the box is ticked */
+.ss-spec .ss-check:not([data-state="checked"]) .ss-check__box { border-color: color-mix(in srgb, var(--color-input) 70%, transparent); background: transparent; }
+.ss-spec:hover .ss-check .ss-check__box, .ss-spec:focus-within .ss-check .ss-check__box { border-color: var(--color-input); }
+.ss-spec .ss-check:hover .ss-check__box { border-color: var(--color-primary); }
+
+/* SpecListItem */
+.ss-spec { display: flex; align-items: center; gap: var(--space-2); height: var(--size-row); padding: 0 var(--space-1) 0 var(--space-2); border-radius: var(--radius-md); color: var(--color-sidebar-foreground); font-size: 13px; line-height: 18px; font-weight: 500; cursor: pointer; position: relative; }
+.ss-spec, .ss-menu__item, .ss-dd__opt, .ss-tab, .ss-seg__opt, .ss-select__trigger { transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), border-color var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out); }
