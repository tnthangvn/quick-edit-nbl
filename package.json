{
  "name": "spec-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:build": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/build-openapi.ts",
    "api:lint": "redocly lint docs/api.json --format=stylish",
    "api:gen": "orval",
    "api": "pnpm api:build && pnpm api:lint && pnpm api:gen",
    "predev": "pnpm api",
    "prebuild": "pnpm api",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db.ts migrate",
    "db:rollback": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db.ts rollback",
    "db:status": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db.ts status",
    "db:make": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db.ts make",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db.ts seed",
    "db:reset": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db.ts reset"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.74",
    "@ai-sdk/google": "^4.0.90",
    "@ai-sdk/openai": "^4.0.86",
    "@ai-sdk/react": "^4.0.133",
    "@hookform/resolvers": "^5.9.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@monaco-editor/react": "^4.7.0",
    "@napi-rs/keyring": "^2.1.0",
    "@tanstack/react-query": "^5.104.1",
    "ai": "^7.0.130",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "execa": "^10.1.0",
    "googleapis": "^183.0.0",
    "kysely": "^0.29.6",
    "lucide-react": "^1.52.0",
    "monaco-editor": "^0.57.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "ollama-ai-provider-v2": "^4.0.1",
    "pg": "^8.23.1",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "simple-git": "^4.0.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@redocly/cli": "^2.59.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "orval": "^8.40.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24 <25"
  }
}
